<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Network access to the backends the user configures -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Legacy external storage, only so crash logs can be mirrored into the public
         Download/MimiPanel folder on API 26-28 (1.4.15). API 29+ uses MediaStore and
         needs no permission; this declaration is capped at API 28. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <!-- androidx.core adds this signature permission for dynamic receivers; the app registers none -->
    <permission android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" tools:node="remove" />
    <uses-permission android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" tools:node="remove" />
    <application
        android:name=".MimiApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.MimiPanel"
        android:usesCleartextTraffic="true"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:supportsRtl="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver
            android:name=".widget.MimiWidgetProvider"
            android:exported="false"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="net.zash.clashpanel.WIDGET_REFRESH" />
                <action android:name="net.zash.clashpanel.WIDGET_MODE_RULE" />
                <action android:name="net.zash.clashpanel.WIDGET_MODE_GLOBAL" />
                <action android:name="net.zash.clashpanel.WIDGET_MODE_DIRECT" />
                <action android:name="net.zash.clashpanel.WIDGET_CYCLE_NODE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/mimi_widget_info" />
        </receiver>
    </application>
</manifest>
