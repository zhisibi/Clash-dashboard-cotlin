<?xml version="1.0" encoding="utf-8"?>
<!-- Widget gradient: theme red melting into the brand blue-purple (1.4.0). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="#D32F2F"
        android:centerColor="#7E57C2"
        android:endColor="#1A237E"
        android:type="linear" />
    <corners android:radius="24dp" />
    <stroke android:width="1dp" android:color="#59FFFFFF" />
</shape>
